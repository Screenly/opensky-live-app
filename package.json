{
  "name": "opensky-flight-map",
  "version": "0.1.0",
  "description": "Live air traffic from the OpenSky Network: the sky around this screen, an airport's traffic, or one flight followed across the map.",
  "type": "module",
  "scripts": {
    "prebuild": "bun run type-check",
    "generate-mock-data": "screenly edge-app run --generate-mock-data",
    "generate-reference-data": "node scripts/generate-reference-data.mjs",
    "cors-proxy-server": "edge-apps-scripts cors-proxy",
    "dev": "run-p cors-proxy-server edge-apps-dev",
    "edge-apps-dev": "edge-apps-scripts dev",
    "build": "edge-apps-scripts build",
    "postbuild": "node scripts/inline-bundle.mjs",
    "build:dev": "edge-apps-scripts build:dev",
    "build:prod": "edge-apps-scripts build",
    "test": "bun test --pass-with-no-tests src/",
    "test:unit": "bun test --pass-with-no-tests src/",
    "lint": "edge-apps-scripts lint --fix",
    "format": "prettier --write src/ scripts/ e2e/ README.md index.html",
    "format:check": "prettier --check src/ scripts/ e2e/ README.md index.html",
    "deploy": "bun run build && screenly edge-app deploy --path=dist/",
    "type-check": "edge-apps-scripts type-check",
    "screenshots": "edge-apps-scripts screenshots"
  },
  "prettier": "./.prettierrc.json",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@screenly/edge-apps": "^26.8.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^25.4.0",
    "npm-run-all2": "^8.0.4",
    "offline-geocode-city": "^1.0.2",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "author": "Salman Faris",
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core"
  ]
}
